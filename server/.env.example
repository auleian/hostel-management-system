# ─────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3100
MONGODB_URI=mongodb://localhost:27017/booking
JWT_SECRET=replace-me-with-a-long-random-string

# Public base URL of THIS api (used in payment webhook callback URLs).
# On Render, set this to your service URL.
PUBLIC_BASE_URL=https://hostelmanagement-dev.onrender.com

# ─────────────────────────────────────────────────────────────
# MTN MoMo Collections (sandbox)
# https://momodeveloper.mtn.com/
# ─────────────────────────────────────────────────────────────
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER_ID=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_CURRENCY=EUR
# Sandbox-only: booking amounts are stored in UGX but sandbox accepts EUR.
# When targetEnvironment=sandbox AND currency=EUR, the amount is divided by this rate.
# Production (UGX) ignores this entirely.
MTN_SANDBOX_UGX_PER_EUR=4000
# Optional: override callback host if different from PUBLIC_BASE_URL
MTN_MOMO_CALLBACK_HOST=
# Optional: shared secret for X-Webhook-Secret header on MTN callbacks
MTN_MOMO_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────
# Airtel Money Collections (sandbox)
# https://developers.airtel.africa/
# ─────────────────────────────────────────────────────────────
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=UG
AIRTEL_CURRENCY=UGX
AIRTEL_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────
# Email — SMTP (Nodemailer). Use Mailtrap, Brevo, SendGrid, etc.
# ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Hostel System <no-reply@hostel.local>"

# ─────────────────────────────────────────────────────────────
# SMS — Africa's Talking (sandbox). Username "sandbox" works in dev.
# https://account.africastalking.com/apps/sandbox
# ─────────────────────────────────────────────────────────────
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

